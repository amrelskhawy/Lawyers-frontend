# Environment-specific values for the frontend.
#
# Angular resolves these through src/app/environments/*.ts (swapped at build time
# via `fileReplacements` in angular.json), NOT via a runtime .env file. This file
# is the canonical reference of what each environment must define; copy the value
# into the matching environment.ts / environment.pord.ts.
#
# environment.ts        -> local development
# environment.pord.ts   -> production build

# Backend REST API base URL (must end with a trailing slash)
#   dev:  http://localhost:8000/api/v1/
#   prod: https://www.saadalboqami.com/api/v1/
BASE_API=https://your-backend.example.com/api/v1/

# Google Tag Manager / Google Ads conversion id
GTM_ID=AW-XXXXXXXXXX
